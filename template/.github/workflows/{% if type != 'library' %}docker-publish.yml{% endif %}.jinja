name: CI/CD

on:
  push:
    branches:
      - {{ default_branch }}
    tags:
      - "v*.*.*"
  pull_request:
    branches:
      - {{ default_branch }}
{% raw %}
concurrency:
  group: docker-publish-${{ github.ref }}
  cancel-in-progress: false

jobs:
  quality:
    name: Quality Gate
    runs-on: ubuntu-latest
    permissions:
      contents: read
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Install Nix
        uses: DeterminateSystems/nix-installer-action@main

      # Runs every nox session (taplo, format, check, rails, mypy, pytest) via
      # the package's checkPhase, using the exact tool versions pinned in
      # flake.lock. This keeps CI identical to local `nix develop` and stops the
      # two drifting apart. `.#default` rather than `.#<name>` so it keeps
      # working whatever the package is called.
      - name: Quality gate (nox via nix flake)
        run: nix build '.#default' -L

  # Attaches the committed OpenAPI document to the GitHub release for a version
  # tag, so consumers can pin their contract tests to the release they deploy.
  release-openapi:
    needs: quality
    if: startsWith(github.ref, 'refs/tags/v')
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Upload openapi.json to the release
        env:
          GH_TOKEN: ${{ github.token }}
          TAG: ${{ github.ref_name }}
        run: |
          if [ ! -f openapi.json ]; then
            echo "No openapi.json in this project; nothing to publish."
            exit 0
          fi
          gh release view "$TAG" >/dev/null 2>&1 || gh release create "$TAG" --generate-notes
          gh release upload "$TAG" openapi.json --clobber

  # Independent of this repo's own noxfile: catches a project that
  # dropped the rails session or narrowed its spec, which `quality` cannot see.
  rails-check:
    uses: grmhay/pythonproject/.github/workflows/rails-check.yml@main

  build-and-push:
    needs: [quality, rails-check]
    runs-on: ubuntu-latest
    permissions:
      contents: read
    outputs:
      # The multi-arch manifest digest, handed to the deploy-PR job below so the
      # control plane pins this exact build. Empty on pull_request builds, which
      # do not push.
      digest: ${{ steps.push.outputs.digest }}
      # The image repository this build published to, so the deploy-PR job does
      # not have to reconstruct it from a secret.
      image: ${{ steps.image.outputs.value }}
      # Whether OPS_DEPLOY_PAT is configured. The deploy-PR job is skipped
      # rather than failed when it is absent, e.g. in a newly generated repo.
      deploy-pr-enabled: ${{ steps.pat.outputs.present }}
    env:
      DOCKERHUB_USERNAME: ${{ secrets.DOCKERHUB_USERNAME }}

    steps:
      - name: Checkout repository
        # Full history and tags: setuptools-scm derives the version from them.
        uses: actions/checkout@v5
        with:
          fetch-depth: 0
          fetch-tags: true

      - name: Get project name
        id: project
        run: |
          echo "name=$(python3 -c "import tomllib; f=open('pyproject.toml','rb'); print(tomllib.load(f)['project']['name'])")" >> $GITHUB_OUTPUT

      - name: Compute image name
        id: image
        run: echo "value=${DOCKERHUB_USERNAME}/${{ steps.project.outputs.name }}" >> "$GITHUB_OUTPUT"

      # The image build has no .git, so compute the version here and pass it in
      # as a build arg (see the Dockerfile).
      - name: Compute package version
        id: scm
        run: |
          pip install --quiet 'setuptools-scm>=8'
          VERSION=$(python -m setuptools_scm)
          echo "Computed version: $VERSION"
          echo "value=$VERSION" >> "$GITHUB_OUTPUT"

      - name: Log in to Docker Hub
        if: github.event_name != 'pull_request' && env.DOCKERHUB_USERNAME != ''
        uses: docker/login-action@v4
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Extract metadata
        id: meta
        uses: docker/metadata-action@v6
        with:
          images: ${{ steps.image.outputs.value }}
          tags: |
            type=semver,pattern={{version}}
            type=semver,pattern={{major}}.{{minor}}
            type=sha,prefix=sha-,format=short
            type=raw,value=latest,enable={{is_default_branch}}

      - name: Check whether the deploy-PR token is configured
        id: pat
        env:
          OPS_DEPLOY_PAT: ${{ secrets.OPS_DEPLOY_PAT }}
        run: |
          if [ -n "$OPS_DEPLOY_PAT" ]; then
            echo "present=true" >> "$GITHUB_OUTPUT"
          else
            echo "present=false" >> "$GITHUB_OUTPUT"
          fi

      - name: Set up QEMU
        uses: docker/setup-qemu-action@v4

      - name: Set up Docker Buildx
        uses: docker/setup-buildx-action@v4

      - name: Build and push image
        id: push
        uses: docker/build-push-action@v7
        with:
          context: .
          platforms: linux/amd64,linux/arm64
          push: ${{ github.event_name != 'pull_request' && env.DOCKERHUB_USERNAME != '' }}
          tags: ${{ steps.meta.outputs.tags }}
          labels: ${{ steps.meta.outputs.labels }}
          build-args: |
            VERSION=${{ steps.scm.outputs.value }}
          sbom: true
          provenance: mode=max
          cache-from: type=gha
          cache-to: type=gha,mode=max

      # Advisory: reports CRITICAL/HIGH findings without failing the build.
      - name: Scan for vulnerabilities
        if: steps.push.outputs.digest != ''
        uses: aquasecurity/trivy-action@master
        with:
          image-ref: ${{ steps.image.outputs.value }}@${{ steps.push.outputs.digest }}
          format: table
          exit-code: "0"
          severity: CRITICAL,HIGH

  # Opens or updates the single deploy/<stack> PR in the ops control plane,
  # bumping the pinned digest to this build. Merging that PR is the approval
  # point; the reconciler rolls it out from there. Stays dormant until the
  # image actually publishes, since digest is empty until then, and is skipped
  # rather than failed while OPS_DEPLOY_PAT is unset.
  deploy-pr:
    needs: build-and-push
{%- endraw %}
    if: >-
      github.ref == 'refs/heads/{{ default_branch }}' &&
      needs.build-and-push.outputs.digest != '' &&
      needs.build-and-push.outputs.deploy-pr-enabled == 'true'
{%- raw %}
    uses: grmhay/homelab-opscontrolplane/.github/workflows/deploy-pr.yml@master
    with:
      image: ${{ needs.build-and-push.outputs.image }}
      digest: ${{ needs.build-and-push.outputs.digest }}
      source-sha: ${{ github.sha }}
    secrets:
      token: ${{ secrets.OPS_DEPLOY_PAT }}
{%- endraw %}
