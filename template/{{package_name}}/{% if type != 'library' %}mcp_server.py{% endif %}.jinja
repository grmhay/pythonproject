"""This module provides the MCP server."""

from fastmcp import FastMCP
{%- if fleet_common %}
from homelab_fleet.mcp import McpConfig
{%- endif %}

from {{ package_name }} import __version__

mcp = FastMCP("{{ project_name }}")


@mcp.tool
def get_version() -> str:
    """Return the current package version."""
    return __version__


@mcp.resource("info://version")
def version_resource() -> str:
    """Return the package version as a resource."""
    return __version__


def run() -> None:
{%- if fleet_common %}
    """Run the MCP server over the transport MCP_TRANSPORT selects."""
    mcp.run(**McpConfig.from_env().run_kwargs())
{%- else %}
    """Run the MCP server."""
    mcp.run()
{%- endif %}
