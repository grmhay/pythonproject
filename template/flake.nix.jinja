{
  description = "{{ description }}";

  inputs = {
    nixpkgs.url = "github:nixos/nixpkgs/nixos-unstable";
    flake-utils.url = "github:numtide/flake-utils";
    pythonproject.url = "github:grmhay/pythonproject";
{%- if fleet_common %}

    ## Fleet conventions. Follows this flake's nixpkgs so the package is built
    ## against the same Python as everything else; pinned in flake.lock.
    homelab-fleet-common = {
      url = "github:grmhay/homelab-fleet-common";
      inputs.nixpkgs.follows = "nixpkgs";
    };
{%- endif %}
  };

  outputs = { self, nixpkgs, flake-utils, pythonproject, {% if fleet_common %}homelab-fleet-common, {% endif %}... }:
    flake-utils.lib.eachDefaultSystem (system:
      let
        ## Import nixpkgs:
        pkgs = import nixpkgs { inherit system; };

        ## Read pyproject.toml file:
        pyproject = builtins.fromTOML (builtins.readFile ./pyproject.toml);

        ## Get project specification:
        project = pyproject.project;

        ## Version for nix-built artifacts. setuptools-scm derives the real one
        ## from git tags in CI; a flake source has no .git, so the flake's own
        ## revision is the only git fact available here. Using it keeps a
        ## nix-built artifact identifiable instead of stamping every build with
        ## the same placeholder.
        revision = self.shortRev or self.dirtyShortRev or "unknown";
        version = project.version or "0.0.0+g${revision}";

        ## Strip version specifiers and extras from a PEP 508 dependency name:
        depName = dep: builtins.head (builtins.split "[>=<;![ \t]" dep);

        ## Packages that come from flake inputs rather than nixpkgs, keyed by
        ## their pyproject.toml name. pyproject pins a URL for pip (the Docker
        ## build); the flake input supplies the same package to nix.
        flakePackages = {
{%- if fleet_common %}
          homelab-fleet-common = homelab-fleet-common.packages.${system}.default;
{%- endif %}
        };

        ## Resolve a PEP 508 dependency to a nix package:
        resolveDep = dep: flakePackages.${depName dep} or pkgs.python3Packages.${depName dep};

        ## Resolve runtime Python dependencies from pyproject.toml:
        pythonDeps = map resolveDep project.dependencies;

        ## Resolve test Python dependencies from pyproject.toml:
        testDeps = map resolveDep project."optional-dependencies".test;

        ## The canonical dev-rails checker, pinned in flake.lock. One
        ## definition lives upstream; this repo does not vendor a copy.
        railsChecker = pythonproject.packages.${system}.check-rails;

        ## Get the package:
        package = pkgs.python3Packages.buildPythonPackage {
          ## Set the package name:
          pname = project.name;

          ## The build source is a nix store path with no .git, so setuptools-scm
          ## cannot derive a version itself; hand it the revision-based one.
          inherit version;
          SETUPTOOLS_SCM_PRETEND_VERSION = version;

          ## Set the package format:
          format = "pyproject";

          ## Set the package source:
          src = ./.;

          ## Specify the build system to use:
          build-system = with pkgs.python3Packages; [
            setuptools
            setuptools-scm
          ];

          ## Specify test dependencies (Python deps from pyproject.toml + non-Python tools):
          nativeCheckInputs = testDeps ++ [
            pkgs.taplo

            ## The `rails` session runs inside checkPhase too, so the checker
            ## has to be here as well as in the dev shell.
            railsChecker
          ];

          ## Define the check phase:
          checkPhase = ''
            runHook preCheck
            nox
            runHook postCheck
          '';

          ## Specify production dependencies from pyproject.toml:
          propagatedBuildInputs = pythonDeps;
        };

        ## Make our package editable:
        editablePackage = pkgs.python3.pkgs.mkPythonEditablePackage {
          pname = project.name;
          ## A library has no [project.scripts] table.
          scripts = project.scripts or { };
          inherit version;
          root = "$PWD";
        };
      in
      {
        ## Project packages output:
        packages = {
          "${project.name}" = package;
          default = self.packages.${system}.${project.name};
        };

        ## Project development shell output:
        devShells = {
          default = pkgs.mkShell {
            inputsFrom = [
              package
            ];

            buildInputs = [
              #################
              ## OUR PACKAGE ##
              #################

              editablePackage

              #################
              # VARIOUS TOOLS #
              #################

              pkgs.python3Packages.build
              pkgs.python3Packages.ipython

              ## Provides `check-rails` for the `rails` nox session:
              railsChecker

              ####################
              # EDITOR/LSP TOOLS #
              ####################

              # LSP server:
              pkgs.python3Packages.python-lsp-server

              # LSP server plugins of interest:
              pkgs.python3Packages.pylsp-mypy
              pkgs.python3Packages.pylsp-rope
              pkgs.python3Packages.python-lsp-ruff
              pkgs.nodejs
            pkgs.pre-commit
            ];

            shellHook = ''
              npm install --silent
            '';
          };
        };
      });
}
