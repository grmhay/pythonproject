"""
Test suite.

A few examples for invoking `nox`:

    nox --list
    nox
    nox -s taplo
    nox -s taplo -- --fix
    nox -s format
    nox -s format -- --fix
    nox -s check
    nox -k "not pytest"
    nox -k "not mypy and not pytest"
"""

import importlib
import sys
import tempfile
import tomllib
from pathlib import Path

import nox

#: Project-specific sessions; see the bottom of this file.
_local = Path(__file__).with_name("noxfile_local.py")

#: Files and directories of interest.
paths = [
    "noxfile.py",
    "tests",
    "{{ package_name }}",
    *([_local.name] if _local.exists() else []),
]


@nox.session(python=False)
def taplo(session: nox.Session) -> None:
    """Lint and check format of TOML files in the repository."""
    ## Do we want to fix the format issues?
    if "--fix" in session.posargs:
        session.run("taplo", "fmt", external=True)
    else:
        session.run("taplo", "lint")
        session.run("taplo", "fmt", "--check")


@nox.session(python=False, name="format")
def ruff_format(session: nox.Session) -> None:
    """Format codebase and sort imports."""
    ## Do we want to fix the format issues?
    if "--fix" in session.posargs:
        session.run("ruff", "format", *paths, external=True)
        session.run("ruff", "check", "--select=I", "--fix", *paths, external=True)
    else:
        session.run("ruff", "format", "--check", *paths, external=True)
        session.run("ruff", "check", "--select=I", *paths, external=True)


@nox.session(python=False, name="check")
def ruff_check(session: nox.Session) -> None:
    """Lint and check codebase."""
    ## Define default arguments:
    args = []

    ## Do we want statistics?
    if "--stats" in session.posargs:
        args.append("--statistics")

    ## Do we want JSON output?
    if "--json" in session.posargs:
        args.extend(["--output-format", "json"])

    ## All other arguments are passed as is:
    args.extend(arg for arg in session.posargs if arg not in ["--stats", "--json"])

    ## Run ruff:
    session.run("ruff", "check", *args, *paths, external=True)


@nox.session(python=False)
def rails(session: nox.Session) -> None:
    """Check this project still matches the canonical dev rails."""
    session.run("check-rails", ".", external=True)


@nox.session(python=False)
def mypy(session: nox.Session) -> None:
    """Type-check on the codebase."""
    session.run("mypy", "--no-install-types", *paths, external=True)


#: Renders an app's OpenAPI document. Runs in a subprocess so it imports the
#: app with the project's own interpreter and dependencies, not nox's.
_OPENAPI_SCRIPT = """
import importlib, json, sys
module, _, attr = sys.argv[1].partition(":")
spec = getattr(importlib.import_module(module), attr).openapi()
# The app version changes on every commit; the contract does not.
spec["info"]["version"] = "0.0.0"
with open(sys.argv[2], "w") as f:
    f.write(json.dumps(spec, indent=2, sort_keys=True) + "\\n")
"""


@nox.session(python=False)
def openapi(session: nox.Session) -> None:
    """Check the committed openapi.json matches the API; --write regenerates it.

    Consumers test against this file, so an API change cannot merge without
    updating it. Enabled by `openapi-app = "module:app"` under
    [tool.pythonproject] in pyproject.toml; skipped otherwise.
    """
    with Path("pyproject.toml").open("rb") as f:
        config = tomllib.load(f).get("tool", {}).get("pythonproject", {})
    app = config.get("openapi-app")
    if not app:
        session.skip("no openapi-app under [tool.pythonproject] in pyproject.toml")

    committed = Path("openapi.json")
    if "--write" in session.posargs:
        session.run("python", "-c", _OPENAPI_SCRIPT, app, str(committed), external=True)
        return

    with tempfile.TemporaryDirectory() as tmp:
        fresh = Path(tmp) / "openapi.json"
        session.run("python", "-c", _OPENAPI_SCRIPT, app, str(fresh), external=True)
        if not committed.exists() or committed.read_text() != fresh.read_text():
            session.error("openapi.json is stale; run `nox -s openapi -- --write`")


@nox.session(python=False)
def pytest(session: nox.Session) -> None:
    """Run the test suite."""
    session.run("pytest", external=True)


## Project-specific sessions live in noxfile_local.py, which the template never
## touches, so `copier update` can keep this file in sync with the rails.
## Importing it is enough: nox registers sessions as they are decorated.
if _local.exists():
    sys.path.insert(0, str(_local.parent))
    importlib.import_module(_local.stem)
