[project]
name = "{{ project_name }}"
dynamic = ["version"]
description = "{{ description }}"
readme = "README.md"
requires-python = ">=3.11"
license = "MIT"
authors = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
maintainers = [{ name = "{{ author_name }}", email = "{{ author_email }}" }]
keywords = [{% if type in ['cli', 'both'] %}"cli"{% endif %}{% if type == 'both' %}, {% endif %}{% if type in ['api', 'both'] %}"api"{% endif %}]
classifiers = [
  "Development Status :: 1 - Planning",
{%- if type in ['cli', 'both'] %}
  "Environment :: Console",
{%- endif %}
  "Intended Audience :: Developers",
  "Programming Language :: Python",
  "Programming Language :: Python :: 3 :: Only",
  "Programming Language :: Python :: 3.11",
  "Programming Language :: Python :: 3.12",
  "Programming Language :: Python :: 3.13",
  "Topic :: Software Development :: Tools",
  "Typing :: Typed",
]

{% if type == 'library' -%}
dependencies = []
{%- elif type == 'cli' -%}
dependencies = ["click", "fastmcp"]
{%- elif type == 'api' -%}
dependencies = ["fastapi", "fastmcp", "uvicorn"]
{%- else -%}
dependencies = ["click", "fastapi", "fastmcp", "uvicorn"]
{%- endif %}

[project.optional-dependencies]

test = [{% if type in ['api', 'both'] %}"httpx", {% endif %}"mypy", "nox", "pytest", "anyio", "ruff"]
{%- if type != 'library' %}

#####################
## PROJECT SCRIPTS ##
#####################

[project.scripts]
{% if type in ['cli', 'both'] %}
{{ project_name }} = "{{ package_name }}.cli:main"
{%- endif %}
{%- if type in ['api', 'both'] %}
{{ project_name }}-api = "{{ package_name }}.api:run"
{%- endif %}
{{ project_name }}-mcp = "{{ package_name }}.mcp_server:run"
{%- endif %}

################################
## BUILD SYSTEM CONFIGURATION ##
################################

[build-system]

requires = ["setuptools>=64", "setuptools-scm>=8"]
build-backend = "setuptools.build_meta"

##############################
## SETUPTOOLS CONFIGURATION ##
##############################

# Version is derived from git tags by setuptools-scm; never hardcode it.
# The .git directory is absent from the container build context, so the image
# build passes the computed value via SETUPTOOLS_SCM_PRETEND_VERSION; this
# fallback is used only when neither git metadata nor that env var is available.
[tool.setuptools_scm]

fallback_version = "0.0.0+unknown"

[tool.setuptools.packages.find]

where = ["."]
include = ["{{ package_name }}*"]
exclude = ["tests*"]

[tool.setuptools.package-data]

{{ package_name }} = ["resources/*"]

##########################
## PYTEST CONFIGURATION ##
##########################

[tool.pytest.ini_options]

addopts = ["--doctest-modules"]

testpaths = ["tests", "{{ package_name }}"]

########################
## MYPY CONFIGURATION ##
########################

[tool.mypy]

{% if type != 'library' -%}
plugins = ["pydantic.mypy"]
{% endif -%}

## The dev rails require every function to be annotated; strict is what
## actually enforces that. Keep it on -- a project that turns it off has left
## the rails (see the `rails` nox session).
strict = true


########################
## RUFF CONFIGURATION ##
########################

[tool.ruff]

## Set the required version of ruff:
required-version = ">=0.11.7"

## Exclude directories and files from ruff runs:
exclude = [
  ## Common excludes:
  ".bzr",
  ".direnv",
  ".eggs",
  ".git",
  ".git-rewrite",
  ".hg",
  ".ipynb_checkpoints",
  ".mypy_cache",
  ".nox",
  ".pants.d",
  ".pyenv",
  ".pytest_cache",
  ".pytype",
  ".ruff_cache",
  ".svn",
  ".tox",
  ".venv",
  ".vscode",
  "__pypackages__",
  "_build",
  "buck-out",
  "build",
  "dist",
  "node_modules",
  "site-packages",
  "venv",
]

## Make the default fix behaviour `false`:
fix = false

[tool.ruff.format]

docstring-code-format = true

[tool.ruff.lint]

## Enable specific rules or categories:
select = [
  "AIR",   ## Airflow
  "ERA",   ## eradicate
  "FAST",  ## FastAPI
  "YTT",   ## flake8-2020
  "ANN",   ## flake8-annotations
  "ASYNC", ## flake8-async
  "S",     ## flake8-bandit
  "BLE",   ## flake8-blind-except
  "FBT",   ## flake8-boolean-trap
  "B",     ## flake8-bugbear
  "A",     ## flake8-builtins
  "COM",   ## flake8-commas
  "C4",    ## flake8-comprehensions
  "CPY",   ## flake8-copyright
  "DTZ",   ## flake8-datetimez
  "T10",   ## flake8-debugger
  "DJ",    ## flake8-django
  "EM",    ## flake8-errmsg
  "EXE",   ## flake8-executable
  "FIX",   ## flake8-fixme
  "FA",    ## flake8-future-annotations
  "INT",   ## flake8-gettext
  "ISC",   ## flake8-implicit-str-concat
  "ICN",   ## flake8-import-conventions
  "LOG",   ## flake8-logging
  "G",     ## flake8-logging-format
  "INP",   ## flake8-no-pep420
  "PIE",   ## flake8-pie
  "T20",   ## flake8-print
  "PYI",   ## flake8-pyi
  "PT",    ## flake8-pytest-style
  "Q",     ## flake8-quotes
  "RSE",   ## flake8-raise
  "RET",   ## flake8-return
  "SLF",   ## flake8-self
  "SIM",   ## flake8-simplify
  "SLOT",  ## flake8-slots
  "TID",   ## flake8-tidy-imports
  "TD",    ## flake8-todos
  "TC",    ## flake8-type-checking
  "ARG",   ## flake8-unused-arguments
  "PTH",   ## flake8-use-pathlib
  "FLY",   ## flynt
  "I",     ## isort
  "C90",   ## mccabe
  "NPY",   ## NumPy-specific rules
  "PD",    ## pandas-vet
  "N",     ## pep8-naming
  "PERF",  ## Perflint
  "E",     ## pycodestyle -> Error
  "W",     ## pycodestyle -> Warning
  "DOC",   ## pydoclint
  "D",     ## pydocstyle
  "F",     ## Pyflakes
  "PGH",   ## pygrep-hooks
  "PLC",   ## Pylint -> Convention
  "PLE",   ## Pylint -> Error
  "PLR",   ## Pylint -> Refactor
  "PLW",   ## Pylint -> Warning
  "UP",    ## pyupgrade
  "FURB",  ## refurb
  "RUF",   ## Ruff-specific rules
  "TRY",   ## tryceratops
]

## Ignore specific rules or categories:
ignore = ["COM812"]

[tool.ruff.lint.pydocstyle]

convention = "pep257"
