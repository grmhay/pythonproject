FROM python:3.13-slim AS builder

WORKDIR /build

# The .git directory is not in the build context, so setuptools-scm cannot read
# the tag history here. The build passes the version it computed from git as a
# build arg, exposed to setuptools-scm via SETUPTOOLS_SCM_PRETEND_VERSION. When
# the arg is omitted, setuptools-scm falls back to the value in pyproject.toml.
ARG VERSION
ENV SETUPTOOLS_SCM_PRETEND_VERSION=$VERSION

COPY pyproject.toml README.md ./
COPY {{ package_name }}/ {{ package_name }}/

RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir build setuptools-scm && \
    python -m build --wheel


FROM python:3.13-slim

WORKDIR /app

COPY --from=builder /build/dist/*.whl ./

RUN pip install --no-cache-dir *.whl && \
    rm -f *.whl

ENTRYPOINT ["{{ project_name }}{% if type == 'api' %}-api{% endif %}"]
